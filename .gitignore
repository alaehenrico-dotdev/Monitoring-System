node_modules/
dist/
build/
*.log
.DS_Store
coverage/
server/generated/
*.tsbuildinfo
client/vite.config.js
client/vite.config.d.ts

# --- Secrets -----------------------------------------------------------------
# Every real environment file, at any depth: .env, .env.local, .env.production,
# .env.docker ... The committed templates (*.example) are the only exceptions, so
# a new setting still has to be documented in one. (A bare ".env" used to be the
# only rule, which left .env.production and the like unprotected.)
.env
.env.*
!.env.example
!.env.*.example

# TLS certificates / keys for docker-compose.tls.yml
certs/
*.pem
*.key
*.p12
*.pfx

# Google credentials (Settings > Google Drive, docs/GOOGLE_DRIVE.md). The console's
# "Download JSON" button on an OAuth client saves client_secret_<id>.json, which holds
# the real client secret; service-account keys are the same kind of file. The client id
# and secret belong in .env, never in a committed file.
client_secret*.json
*.apps.googleusercontent.com.json
service-account*.json
*-service-account*.json

# --- Data that must never be committed ----------------------------------------
# Database dumps and backups. The backup scripts write outside the repo by default
# (C:\ala-eh-backups, /var/backups/ala-eh); this catches one pointed inside it.
# Deliberately NOT "*.sql": the migrations under server/prisma/migrations are SQL
# and are source.
*.sql.gz
*.sql.gz.*
*.dump
backups/
snapshots/

# --- Local tooling and test output --------------------------------------------
# Personal Claude Code settings (the shared agents/skills under .claude/ stay tracked).
.claude/settings.local.json
.claude/**/*.local.*
# Vite leaves these behind when its config fails to load.
vite.config.*.timestamp-*
# Test and process output.
test-results/
playwright-report/
logs/
.pm2/
*.tgz

# --- Editors and OS ------------------------------------------------------------
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
# Office lock/temp files left beside an open spreadsheet (e.g. the encoder order .xlsx).
~$*
*.tmp

# --- Build caches and tool output ------------------------------------------------
# Vite/ESLint caches and the TypeScript incremental build files (client/tsconfig.tsbuildinfo
# was being left in the working tree).
.vite/
.eslintcache
*.pid
# Screenshots and traces from scripts/e2e.mjs or a local Playwright run.
e2e-output/
screenshots/
# Scratch space for one-off scripts and exports - never source.
scratch/
tmp/

# --- Local data that belongs to a machine, not the repo ---------------------------
# A local MySQL data directory, if one is ever created inside the project, and any
# exported stock/orders spreadsheet or CSV dropped in the root for an import.
mysql-data/
db_data/
/*.xlsx
/*.xls
/*.csv

# --- Leftovers from merges, patches and package managers ------------------------
*.orig
*.rej
*.bak
*.swo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.nyc_output/
# Per-machine overrides of the committed config (a local client/.env.local is already covered by .env.*).
*.local
!*.example
