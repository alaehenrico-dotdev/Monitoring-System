// Ala Eh Food Products - Online & Offline Stocks Monitoring System
// Prisma schema - mirrors Section 5 (Database Design) of the documentation plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ONLINE_ENCODER
  OFFLINE_ENCODER
  SUPERVISOR_ADMIN
}

enum StockLocation {
  ONLINE
  OFFLINE
  TOTAL
}

/// Entries are recorded per operating shift, not just per day: Morning
/// (7am-4pm) and Night (4pm-1am, crossing midnight). See server/src/utils/
/// shift.ts for how a wall-clock time maps to {shift, date}, and Morning is
/// always the shift immediately preceded by the previous date's Night.
enum Shift {
  MORNING
  NIGHT
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

/// 5.9 users - login and role assignment
model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  onlineEntries    DailyOnlineStock[]  @relation("OnlineEncodedBy")
  offlineEntries   DailyOfflineStock[] @relation("OfflineEncodedBy")
  manualCounts     ManualCount[]       @relation("CountedBy")
  changeLogEntries ChangeLog[]         @relation("ChangedBy")

  @@map("users")
}

/// 5.1 products - master product list shared by every table in the system
model Product {
  id        Int      @id @default(autoincrement())
  // The actual SKU code (e.g. "AFP007"), separate from `name` - nullable
  // since not every product has been assigned one yet (see seed.ts), unique
  // when present so two products can never claim the same code.
  sku       String?  @unique
  name      String
  category  String
  unit      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // Section 4.1/4.5 - Low Stock. Null means "no alert configured" for this
  // SKU (most products, until an admin sets one) rather than "alert at
  // zero" - Total Stocks/Dashboard only flag a product once this is set.
  // Compared against Total Stocks' remainingStock, same unit as `unit`.
  lowStockThreshold Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onlineStocks  DailyOnlineStock[]
  offlineStocks DailyOfflineStock[]
  manualCounts  ManualCount[]

  @@map("products")
}

/// 5.2 daily_online_stock - one row per product, per date (Online Monitoring table)
model DailyOnlineStock {
  id                Int      @id @default(autoincrement())
  productId         Int
  product           Product  @relation(fields: [productId], references: [id])
  entryDate         DateTime @db.Date
  shift             Shift    @default(NIGHT)
  openingStock      Decimal  @default(0) @db.Decimal(14, 2)
  stockInOffToOl    Decimal  @default(0) @db.Decimal(14, 2)
  stockOutOlToOff   Decimal  @default(0) @db.Decimal(14, 2)
  onlineStock       Decimal  @default(0) @db.Decimal(14, 2) // calc: opening + in - out
  productionIn      Decimal  @default(0) @db.Decimal(14, 2)
  fulfillmentOut    Decimal  @default(0) @db.Decimal(14, 2)
  rts               Decimal  @default(0) @db.Decimal(14, 2)
  remainingStock    Decimal  @default(0) @db.Decimal(14, 2) // calc: becomes next shift's opening
  encodedById       Int?
  encodedBy         User?    @relation("OnlineEncodedBy", fields: [encodedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, entryDate, shift])
  // Serves cross-product lookups (findAllForDate, dashboard monthly
  // aggregates) that filter/range on entryDate without a productId - the
  // unique key above can't help there since productId is its leftmost
  // column. Confirmed via EXPLAIN against a seeded ~116k-row table: this
  // turns a full table scan into a ref/range lookup.
  @@index([entryDate, shift])
  @@map("daily_online_stock")
}

/// 5.3 daily_offline_stock - one row per product, per date (Offline Monitoring table)
model DailyOfflineStock {
  id                Int      @id @default(autoincrement())
  productId         Int
  product           Product  @relation(fields: [productId], references: [id])
  entryDate         DateTime @db.Date
  shift             Shift    @default(NIGHT)
  openingStock      Decimal  @default(0) @db.Decimal(14, 2)
  stockInOlToOff    Decimal  @default(0) @db.Decimal(14, 2) // mirrors online.stockOutOlToOff
  stockOutOffToOl   Decimal  @default(0) @db.Decimal(14, 2) // mirrors online.stockInOffToOl
  offlineStock      Decimal  @default(0) @db.Decimal(14, 2) // calc: opening + in - out
  productionIn      Decimal  @default(0) @db.Decimal(14, 2)
  deliveryOut       Decimal  @default(0) @db.Decimal(14, 2) // calc: sum of delivery1..delivery5
  delivery1         Decimal  @default(0) @db.Decimal(14, 2)
  delivery2         Decimal  @default(0) @db.Decimal(14, 2)
  delivery3         Decimal  @default(0) @db.Decimal(14, 2)
  delivery4         Decimal  @default(0) @db.Decimal(14, 2)
  delivery5         Decimal  @default(0) @db.Decimal(14, 2)
  backloads         Decimal  @default(0) @db.Decimal(14, 2)
  upsellOut         Int      @default(0)
  remainingStock    Decimal  @default(0) @db.Decimal(14, 2) // calc: becomes next shift's opening
  encodedById       Int?
  encodedBy         User?    @relation("OfflineEncodedBy", fields: [encodedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, entryDate, shift])
  // See the matching index on DailyOnlineStock above - same reasoning.
  @@index([entryDate, shift])
  @@map("daily_offline_stock")
}

/// 5.4 manual_counts - physical count capture; variance is always derived
model ManualCount {
  id                   Int           @id @default(autoincrement())
  productId            Int
  product              Product       @relation(fields: [productId], references: [id])
  entryDate            DateTime      @db.Date
  shift                Shift         @default(NIGHT)
  location             StockLocation
  systemRemainingStock Decimal       @db.Decimal(14, 2)
  manualCount          Decimal       @db.Decimal(14, 2)
  variance             Decimal       @db.Decimal(14, 2) // calc: system - manual
  countedById          Int?
  countedBy            User?         @relation("CountedBy", fields: [countedById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([productId, entryDate, shift, location])
  // Serves findAllForDateAndLocation/findForTotals/findForVarianceReport,
  // all of which filter or range-scan entryDate across products (see the
  // DailyOnlineStock index above for why the unique key doesn't help).
  @@index([entryDate])
  @@map("manual_counts")
}

/// 5.8 change_log - change history for accountability and variance tracing
model ChangeLog {
  id          Int          @id @default(autoincrement())
  tableName   String
  recordId    Int
  action      ChangeAction
  changedById Int?
  changedBy   User?        @relation("ChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime     @default(now())
  oldValue    Json?
  newValue    Json?

  @@map("change_log")
}
