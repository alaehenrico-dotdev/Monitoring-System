// Ala Eh Food Products - Online & Offline Stocks Monitoring System
// Prisma schema - mirrors Section 5 (Database Design) of the documentation plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ONLINE_ENCODER
  OFFLINE_ENCODER
  SUPERVISOR_ADMIN
}

enum StockLocation {
  ONLINE
  OFFLINE
  TOTAL
}

/// Entries are recorded per operating shift, not just per day: Morning
/// (7am-4pm) and Night (4pm-1am, crossing midnight). See server/src/utils/
/// shift.ts for how a wall-clock time maps to {shift, date}, and Morning is
/// always the shift immediately preceded by the previous date's Night.
enum Shift {
  MORNING
  NIGHT
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

/// 5.9 users - login and role assignment
model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  onlineEntries    DailyOnlineStock[]   @relation("OnlineEncodedBy")
  offlineEntries   DailyOfflineStock[]  @relation("OfflineEncodedBy")
  manualCounts     ManualCount[]        @relation("CountedBy")
  changeLogEntries ChangeLog[]          @relation("ChangedBy")
  importBatches    ImportBatch[]        @relation("ImportedBy")
  reportHistory    ReportHistoryEntry[] @relation("GeneratedBy")
  systemLogEntries SystemLogEntry[]     @relation("UpdatedOn")
  stockExtras      DailyStockExtra[]    @relation("ExtraEncodedBy")

  @@map("users")
}

/// 5.1 products - master product list shared by every table in the system
model Product {
  id                Int      @id @default(autoincrement())
  // The actual SKU code (e.g. "AFP007"), separate from `name` - nullable
  // since not every product has been assigned one yet (see seed.ts), unique
  // when present so two products can never claim the same code.
  sku               String?  @unique
  name              String
  category          String
  unit              String
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  // Section 4.1/4.5 - Low Stock. Null means "no alert configured" for this
  // SKU (most products, until an admin sets one) rather than "alert at
  // zero" - Total Stocks/Dashboard only flag a product once this is set.
  // Compared against Total Stocks' remainingStock, same unit as `unit`.
  lowStockThreshold Decimal? @db.Decimal(14, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  onlineStocks  DailyOnlineStock[]
  offlineStocks DailyOfflineStock[]
  manualCounts  ManualCount[]
  stockExtras   DailyStockExtra[]

  // Retained for compatibility with existing databases; the client no
  // longer exposes a sync endpoint.
  @@index([updatedAt])
  @@map("products")
}

/// 5.2 daily_online_stock - one row per product, per date (Online Monitoring table)
model DailyOnlineStock {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  entryDate       DateTime @db.Date
  shift           Shift    @default(NIGHT)
  openingStock    Decimal  @default(0) @db.Decimal(14, 2)
  stockInOffToOl  Decimal  @default(0) @db.Decimal(14, 2)
  stockOutOlToOff Decimal  @default(0) @db.Decimal(14, 2)
  onlineStock     Decimal  @default(0) @db.Decimal(14, 2) // calc: opening + in - out
  productionIn    Decimal  @default(0) @db.Decimal(14, 2)
  fulfillmentOut  Decimal  @default(0) @db.Decimal(14, 2)
  rts             Decimal  @default(0) @db.Decimal(14, 2)
  remainingStock  Decimal  @default(0) @db.Decimal(14, 2) // calc: becomes next shift's opening
  encodedById     Int?
  encodedBy       User?    @relation("OnlineEncodedBy", fields: [encodedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, entryDate, shift])
  // Serves cross-product lookups (findAllForDate, dashboard monthly
  // aggregates) that filter/range on entryDate without a productId - the
  // unique key above can't help there since productId is its leftmost
  // column. Confirmed via EXPLAIN against a seeded ~116k-row table: this
  // turns a full table scan into a ref/range lookup.
  @@index([entryDate, shift])
  // Retained for compatibility with existing databases; no active endpoint
  // uses this index.
  @@index([updatedAt])
  @@map("daily_online_stock")
}

/// 5.3 daily_offline_stock - one row per product, per date (Offline Monitoring table)
model DailyOfflineStock {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  entryDate       DateTime @db.Date
  shift           Shift    @default(NIGHT)
  openingStock    Decimal  @default(0) @db.Decimal(14, 2)
  stockInOlToOff  Decimal  @default(0) @db.Decimal(14, 2) // mirrors online.stockOutOlToOff
  stockOutOffToOl Decimal  @default(0) @db.Decimal(14, 2) // mirrors online.stockInOffToOl
  offlineStock    Decimal  @default(0) @db.Decimal(14, 2) // calc: opening + in - out
  productionIn    Decimal  @default(0) @db.Decimal(14, 2)
  deliveryOut     Decimal  @default(0) @db.Decimal(14, 2) // calc: sum of delivery1..delivery5
  delivery1       Decimal  @default(0) @db.Decimal(14, 2)
  delivery2       Decimal  @default(0) @db.Decimal(14, 2)
  delivery3       Decimal  @default(0) @db.Decimal(14, 2)
  delivery4       Decimal  @default(0) @db.Decimal(14, 2)
  delivery5       Decimal  @default(0) @db.Decimal(14, 2)
  backloads       Decimal  @default(0) @db.Decimal(14, 2)
  upsellOut       Int      @default(0)
  remainingStock  Decimal  @default(0) @db.Decimal(14, 2) // calc: becomes next shift's opening
  encodedById     Int?
  encodedBy       User?    @relation("OfflineEncodedBy", fields: [encodedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, entryDate, shift])
  // See the matching index on DailyOnlineStock above - same reasoning.
  @@index([entryDate, shift])
  // Retained for compatibility with existing databases; no active endpoint
  // uses this index.
  @@index([updatedAt])
  @@map("daily_offline_stock")
}

/// Extra input columns an encoder added to one Online/Offline grid column
/// (client: hooks/useExtraColumns.ts, server: utils/stockExtras.ts). The
/// column they were added to keeps the total - it is a real column on
/// daily_online_stock / daily_offline_stock and stays the single source of
/// truth for Remaining Stock, the totals rows and every report. These are
/// only the individual amounts behind that total, stored when the encoder
/// chooses "Save individually" so the columns come back after a reload.
///
/// Deliberately a side table rather than more columns on the daily tables:
/// how many there are is chosen per sheet at runtime, so there is no fixed
/// column count to add (unlike Delivery (Out)'s five fixed slots, which are
/// columns on daily_offline_stock).
model DailyStockExtra {
  id          Int           @id @default(autoincrement())
  /// ONLINE or OFFLINE - which grid's column this belongs to. TOTAL is in
  /// the enum but never used here: Total Stocks is derived, not encoded.
  location    StockLocation
  productId   Int
  product     Product       @relation(fields: [productId], references: [id])
  entryDate   DateTime      @db.Date
  shift       Shift         @default(NIGHT)
  /// The main column's own key, exactly as the grid config spells it
  /// ("stockInOffToOl", "fulfillmentOut", ...) - see utils/stockExtras.ts,
  /// which is the only place that decides which keys are accepted.
  columnKey   String        @db.VarChar(64)
  /// 1-based, stable for the life of the column: deleting the middle of
  /// three added columns leaves slots 1 and 3, rather than renumbering.
  slotIndex   Int
  amount      Decimal       @default(0) @db.Decimal(14, 2)
  encodedById Int?
  encodedBy   User?         @relation("ExtraEncodedBy", fields: [encodedById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Named explicitly: Prisma's own generated name for a six-column unique
  // key on this table is 76 characters, and MySQL caps an identifier at 64.
  @@unique([location, productId, entryDate, shift, columnKey, slotIndex], map: "daily_stock_extra_slot_key")
  // Serves the grid/report load, which fetches a whole sheet's extras at
  // once without a productId - the unique key above can't help there, since
  // productId is not its leftmost column.
  @@index([location, entryDate, shift])
  @@map("daily_stock_extra")
}

/// 5.4 manual_counts - physical count capture; variance is always derived
model ManualCount {
  id                   Int           @id @default(autoincrement())
  productId            Int
  product              Product       @relation(fields: [productId], references: [id])
  entryDate            DateTime      @db.Date
  shift                Shift         @default(NIGHT)
  location             StockLocation
  systemRemainingStock Decimal       @db.Decimal(14, 2)
  manualCount          Decimal       @db.Decimal(14, 2)
  variance             Decimal       @db.Decimal(14, 2) // calc: system - manual
  // Why the count differs from the system figure - free text, optional (the
  // Audit page's Variance details). Edited on its own, never by a count save.
  remarks              String?       @db.VarChar(500)
  // A count only becomes the next period's opening stock once it is published
  // (the Audit page's Publish button). Null = saved but not yet published;
  // saving a count again un-publishes it, so what was approved is always what
  // carried forward. Counts that existed before this column were published.
  publishedAt          DateTime?
  publishedById        Int?
  countedById          Int?
  countedBy            User?         @relation("CountedBy", fields: [countedById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([productId, entryDate, shift, location])
  // Serves findAllForDateAndLocation/findForTotals/findForVarianceReport,
  // all of which filter or range-scan entryDate across products (see the
  // DailyOnlineStock index above for why the unique key doesn't help).
  @@index([entryDate])
  // Retained for compatibility with existing databases; no active endpoint
  // uses this index.
  @@index([updatedAt])
  @@map("manual_counts")
}

/// 5.8 change_log - change history for accountability and variance tracing
model ChangeLog {
  id            Int          @id @default(autoincrement())
  tableName     String
  recordId      Int
  action        ChangeAction
  changedById   Int?
  changedBy     User?        @relation("ChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime     @default(now())
  oldValue      Json?
  newValue      Json?
  // Set only on the write a CSV import itself produced (see
  // importBatch.service.ts's revertImportBatch) - lets "delete this import"
  // find exactly the rows it touched and undo them, without having to guess
  // from timestamps which change_log rows belong to which import. SetNull
  // (not Cascade) on the batch's own deletion - revertImportBatch deletes the
  // ImportBatch row once it's done reverting, but the change_log rows for the
  // original import (and for the revert itself) stay as the permanent audit
  // trail Section 5.8 exists for.
  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  // The change_log row that triggered this one automatically - set on the
  // follow-on writes a manual count or an entry save makes to later periods
  // (carried-forward opening stock), so they read as consequences rather
  // than as someone's own edit. A plain id, not a relation: it only ever
  // points at an older row of this append-only table.
  causedById    Int?

  @@index([importBatchId])
  // The Change Log's date-range filter (and its newest-first ordering) -
  // without this a date range reads every row ever written.
  @@index([changedAt])
  // change_log is append-only and grows with every stock write, while both
  // of its read paths filter on (tableName, recordId): the Change Log page
  // (changeLogRepository.findMany) and, far more costly,
  // findLatestForRecord - which revertImportBatch calls once per affected
  // record, inside the revert transaction. Without this that lookup is a
  // full scan of the whole audit table per record, so undoing one CSV
  // import gets steadily slower as history accumulates. `id` is included so
  // the `ORDER BY id DESC LIMIT 1` is served by the index too.
  @@index([tableName, recordId, id])
  @@map("change_log")
}

/// Import History (CSV import into Manual Count - see CsvTools.tsx) - one row
/// per confirmed "Save" in the Review Import modal, so an import can later be
/// found and, if needed, cleanly undone (see revertImportBatch). Deleting a
/// batch here reverts the data it changed (change_log rows tagged with this
/// id - see ChangeLog.importBatchId) and then removes this summary row;
/// never the other way around (see importBatch.service.ts).
model ImportBatch {
  id           Int           @id @default(autoincrement())
  location     StockLocation
  entryDate    DateTime      @db.Date
  shift        Shift
  fileName     String
  rowCount     Int           @default(0)
  importedById Int?
  importedBy   User?         @relation("ImportedBy", fields: [importedById], references: [id])
  importedAt   DateTime      @default(now())

  changeLogEntries ChangeLog[]

  @@index([location, entryDate, shift])
  @@map("import_batches")
}

/// DEPRECATED - legacy desktop-sync records, from the Tauri desktop app that
/// was removed in "feat: remove desktop app". Nothing in server/src or
/// client/src references this model; it is kept only so the existing rows in
/// deployed databases are not silently destroyed by a migration.
///
/// Safe to drop once someone confirms no out-of-band consumer (BI tool, ad
/// hoc SQL) still reads sync_push_applications. When dropping, archive first:
///   CREATE TABLE _archive_sync_push_applications AS SELECT * FROM sync_push_applications;
model SyncPushApplication {
  id        Int      @id @default(autoincrement())
  localId   String   @unique
  tableName String
  serverId  Int
  appliedAt DateTime @default(now())

  @@map("sync_push_applications")
}

/// Server-backed Report History (Daily Report / Variance Report) - replaces
/// the old client-only localStorage list (utils/reportHistory.ts) so what's
/// been generated is durable and the same for every device/tester, not just
/// whichever browser happened to generate it. Never stores the report's own
/// data (that's always re-read live when an entry is reopened - see
/// `route`'s own doc comment) - just that it was generated, by whom, and
/// covering what.
model ReportHistoryEntry {
  id            Int      @id @default(autoincrement())
  // "Daily Report" / "Variance Report" - kept as the same free-text label the
  // UI already uses (ReportHistoryPage.tsx), rather than a new enum, since
  // nothing else needs to query across types.
  type          String
  // Human-readable coverage - a single date ("2026-09-27") or a range
  // ("2026-09-01 to 2026-09-07"), exactly as the report page already built it.
  scope         String
  // Where reopening this entry navigates to (e.g.
  // "/daily-report?history=1&date=2026-09-27") - the report page then
  // re-fetches fresh data for that date/range itself; this is never a frozen
  // snapshot, so a reopened report always reflects the current numbers
  // (including anything corrected since it was first generated).
  route         String
  // "online" / "offline" / "all" - which section of the report was generated.
  // Null on entries from before this column (and for reports with no such
  // split, like the Variance Report).
  section       String?
  generatedById Int?
  generatedBy   User?    @relation("GeneratedBy", fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())

  @@index([type, generatedAt])
  @@map("report_history_entries")
}

/// DEPRECATED - legacy desktop-updater history, from the removed Tauri
/// desktop app. Same situation and same removal conditions as
/// SyncPushApplication above: unreferenced by any code, retained only to
/// avoid destroying existing rows.
model SystemLogEntry {
  id          Int      @id @default(autoincrement())
  // Kept as a string to preserve historical event values.
  event       String
  fromVersion String
  toVersion   String
  userId      Int?
  user        User?    @relation("UpdatedOn", fields: [userId], references: [id])
  occurredAt  DateTime @default(now())

  @@index([occurredAt])
  @@map("system_log_entries")
}
