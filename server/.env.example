# MySQL connection string, e.g.:
# mysql://root:password@localhost:3306/ala_eh_stocks
DATABASE_URL="mysql://root:password@localhost:3306/ala_eh_stocks"

PORT=4000
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
CLIENT_ORIGIN="http://localhost:5173"

# Passcode required to unlock the Data Reset admin panel - separate from
# user logins, since this gates an irreversible full data wipe. Required -
# the server refuses to start without it. Change this in every real
# deployment; don't reuse the placeholder below.
DATA_RESET_PASSCODE="000000"
