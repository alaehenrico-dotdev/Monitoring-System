# MySQL connection string, e.g.:
# mysql://root:password@localhost:3306/ala_eh_stocks
DATABASE_URL="mysql://root:password@localhost:3306/ala_eh_stocks"

# "development" (default) or "production" - see PRODUCTION.md.
NODE_ENV="development"
PORT=4000
HOST="127.0.0.1"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
CLIENT_ORIGIN="http://localhost:5173"

# Passcode required to unlock the Data Reset admin panel - separate from
# user logins, since this gates an irreversible full data wipe. Required -
# the server refuses to start without it. Change this in every real
# deployment; don't reuse the placeholder below.
DATA_RESET_PASSCODE="000000"

# Which peers are allowed to set X-Forwarded-For, i.e. Express's `trust proxy`.
# This decides what `req.ip` is, which is what every rate limiter is keyed by.
#
# Default (unset) is "loopback", for a reverse proxy on this same machine
# (such as Nginx) connecting to the API over 127.0.0.1. Its X-Forwarded-For
# is honoured so each real visitor is rate limited separately.
# Anyone hitting the API's port directly is NOT trusted, so a forged
# X-Forwarded-For is ignored and they cannot rotate past the limiters.
#
# Set this only if a proxy fronts the API from some other address:
#   TRUST_PROXY="loopback"              local reverse proxy (default)
#   TRUST_PROXY="10.0.0.5"              a specific proxy
#   TRUST_PROXY="loopback,10.0.0.0/8"   several, comma-separated
#   TRUST_PROXY="false"                 no proxy at all; never trust the header
#   TRUST_PROXY="true"                  trust every hop - UNSAFE unless the API
#                                       is unreachable except through the proxy
# A hop count (e.g. TRUST_PROXY="1") is rejected: it trusts whoever connects,
# which is exactly the forgeable-header hole this replaced.
# TRUST_PROXY="loopback"

# Optional: rate-limit tuning (middleware/rateLimit.ts). Defaults shown; these
# are the values the app shipped with. Windows are in milliseconds.
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_GLOBAL_WINDOW_MS=300000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_PASSCODE_MAX=10
# RATE_LIMIT_PASSCODE_WINDOW_MS=900000

# Optional: full path to mysqldump if the MySQL client tools are not on PATH (used by Settings > Database Backup)
# MYSQLDUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe"
