# MySQL connection string, e.g.:
# mysql://root:password@localhost:3306/ala_eh_stocks
DATABASE_URL="mysql://root:password@localhost:3306/ala_eh_stocks"

PORT=4000
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
CLIENT_ORIGIN="http://localhost:5173"

# If true, saving a Receipt posts its item quantities into that date's
# Online Fulfillment (Out) column by default (Section 4.7). Can also be
# overridden per-request via the `postToFulfillment` body field.
RECEIPTS_AUTO_POST_DEFAULT=true
