# MySQL connection string.
#
# connection_limit is worth setting explicitly on a VPS: Prisma otherwise
# sizes its pool as (CPUs * 2 + 1) per process, and a few pm2 restarts or a
# second service on the same MySQL can exhaust max_connections (151 by
# default). pool_timeout is how long a query waits for a free connection
# before erroring rather than hanging.
#
#   mysql://user:pass@localhost:3306/ala_eh_stocks?connection_limit=10&pool_timeout=20
#
# Connect as a dedicated account limited to this one database - NOT as root. If the
# app is ever compromised (or a query is ever injected), root can read and change every
# database on the server, create users and read files; this account can only touch
# ala_eh_stocks. Create it once, as root (README, "1. Database"):
#
#   CREATE USER 'alaeh_app'@'localhost' IDENTIFIED BY '<a long random password>';
#   GRANT ALL PRIVILEGES ON ala_eh_stocks.* TO 'alaeh_app'@'localhost';
#
# (Docker Compose already does this: it connects as `alaeh_app`, never as root.)
DATABASE_URL="mysql://alaeh_app:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@localhost:3306/ala_eh_stocks?connection_limit=10&pool_timeout=20"

# "development" (default) or "production" - see the README "Production deployment".
NODE_ENV="development"
PORT=4000
HOST="127.0.0.1"
# Minimum 32 characters, and not one of the known placeholders - the server
# refuses to start otherwise. Generate one with:
#   openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# The ONE browser origin allowed through CORS. Required when
# NODE_ENV=production (the server refuses to start without it), because the
# development fallback below would otherwise silently reject every request
# from the real frontend. No trailing slash.
CLIENT_ORIGIN="http://localhost:5173"

# Passcode required to unlock the Data Reset admin panel - separate from
# user logins, since this gates an irreversible full data wipe. Required -
# the server refuses to start without it. Change this in every real
# deployment; don't reuse the placeholder below.
DATA_RESET_PASSCODE="000000"

# Which peers are allowed to set X-Forwarded-For, i.e. Express's `trust proxy`.
# This decides what `req.ip` is, which is what every rate limiter is keyed by.
#
# Default (unset) is "loopback", for a reverse proxy on this same machine
# (such as Caddy) connecting to the API over 127.0.0.1. Its X-Forwarded-For
# is honoured so each real visitor is rate limited separately.
# Anyone hitting the API's port directly is NOT trusted, so a forged
# X-Forwarded-For is ignored and they cannot rotate past the limiters.
#
# Set this only if a proxy fronts the API from some other address:
#   TRUST_PROXY="loopback"              local reverse proxy (default)
#   TRUST_PROXY="10.0.0.5"              a specific proxy
#   TRUST_PROXY="loopback,10.0.0.0/8"   several, comma-separated
#   TRUST_PROXY="false"                 no proxy at all; never trust the header
#   TRUST_PROXY="true"                  trust every hop - UNSAFE unless the API
#                                       is unreachable except through the proxy
# A hop count (e.g. TRUST_PROXY="1") is rejected: it trusts whoever connects,
# which is exactly the forgeable-header hole this replaced.
# TRUST_PROXY="loopback"

# Optional: rate-limit tuning (middleware/rateLimit.ts). Defaults shown; these
# are the values the app shipped with. Windows are in milliseconds.
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_GLOBAL_WINDOW_MS=300000
# RATE_LIMIT_LOGIN_MAX=10
# Failed logins per IP across all usernames (the line above is per IP + username).
# RATE_LIMIT_LOGIN_IP_MAX=50
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_PASSCODE_MAX=10
# RATE_LIMIT_PASSCODE_WINDOW_MS=900000

# Optional: full path to mysqldump if the MySQL client tools are not on PATH (used by Settings > Database Backup)
# MYSQLDUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe"

# Optional: change-log retention. Entries older than this many months are moved
# to change_log_archive by the nightly job (0 turns archiving off). Default 12.
# CHANGE_LOG_RETENTION_MONTHS=12
# Browser error reports are anonymous input, so the table is bounded: reports older
# than CLIENT_ERROR_RETENTION_DAYS go, and only the newest CLIENT_ERROR_MAX_ROWS stay.
# 0 turns a limit off.
# CLIENT_ERROR_RETENTION_DAYS=90
# CLIENT_ERROR_MAX_ROWS=20000

# Optional: folder the backup scripts write to. When set, Settings > Backup &
# Restore lists the files there and can verify them. A backup older than
# BACKUP_OVERDUE_HOURS (default 36) shows as overdue in the Admin queue.
# BACKUP_DIR="/var/backups/ala-eh"
# BACKUP_OVERDUE_HOURS=36
