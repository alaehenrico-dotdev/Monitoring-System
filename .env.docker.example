# Copy to .env (git-ignored) and change every value.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# openssl rand -base64 32
JWT_SECRET=
DATA_RESET_PASSCODE=
# Must exactly match the URL users open in the browser (no trailing slash).
CLIENT_ORIGIN=http://localhost:8080
WEB_PORT=8080
# Optional: days a "Remember this device" sign-in lasts (default 30, max 90, 0 = option off).
# REMEMBER_DEVICE_DAYS=30

# Optional: AI "Explain this variance" button on the Audit page (Supervisor/Admin only).
# Create a key in Google AI Studio. It stays on the server. Empty = the feature is off.
# GEMINI_API_KEY=
# Optional backup keys, used only when the one before is rejected or out of quota (failover). Keys from the
# same Google project share one quota, so a backup only helps if it is from a different project.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-3.5-flash
# Optional fallback provider (used only when Gemini fails for a reason that is about Google). FREE MODELS ONLY:
# OPENROUTER_MODEL must end in ":free" or the server will not start. Both lines are needed.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=   (one or several free models, comma-separated, tried in order - free models are often busy)
# OPENROUTER_DATA_COLLECTION=deny
# The most AI requests one person may make per UTC day, across all AI features (0 = off).
# AI_USER_DAILY_LIMIT=100
# The most model calls the whole server may make per UTC day, across everyone (a cost cap; 0 = off).
# AI_DAILY_CALL_LIMIT=1000

# Google Drive backups and export copies (optional - see docs/GOOGLE_DRIVE.md).
# Create an OAuth client in Google Cloud and paste its id and secret here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered with Google exactly. Google only allows
# http for localhost, so connect from the PC that runs Docker. Defaults to
# http://localhost:<WEB_PORT>/api/drive/oauth/callback.
# GOOGLE_REDIRECT_URI=
# Recommended in production: a separate key for encrypting the stored Drive token.
# Without it the key is derived from JWT_SECRET, so rotating JWT_SECRET silently
# disconnects Drive and the weekly backups stop (docs/OPERATIONS.md).
# Generate with: openssl rand -base64 32. Setting it later means reconnecting Drive.
# DRIVE_TOKEN_KEY=

# Optional: AES-256-GCM encryption of every backup (browser download, Google Drive,
# pre-migration snapshots). Generate with: openssl rand -base64 32
# Keep a copy OUTSIDE the server: without it encrypted backups cannot be opened.
# BACKUP_ENCRYPTION_KEY=

# A real address with HTTPS (Caddy, deploy/caddy/Caddyfile). Point a domain at
# this server, open ports 80 and 443, and set the four lines below; Caddy gets
# and renews the certificate by itself. Leave them out for plain HTTP on
# http://localhost:<WEB_PORT>.
# SITE_ADDRESS=stocks.example.com
# This PC only (nobody else on the network can open it): BIND_ADDRESS=127.0.0.1
# CLIENT_ORIGIN=https://stocks.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
