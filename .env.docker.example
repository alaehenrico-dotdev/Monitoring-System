# Copy to .env (git-ignored) and change every value.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# openssl rand -base64 32
JWT_SECRET=
DATA_RESET_PASSCODE=
# Must exactly match the URL users open in the browser (no trailing slash).
CLIENT_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Google Drive backups and export copies (optional - see docs/GOOGLE_DRIVE.md).
# Create an OAuth client in Google Cloud and paste its id and secret here.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered with Google exactly. Google only allows
# http for localhost, so connect from the PC that runs Docker. Defaults to
# http://localhost:<WEB_PORT>/api/drive/oauth/callback.
# GOOGLE_REDIRECT_URI=
# Optional: a separate key for encrypting the stored Drive token (otherwise
# derived from JWT_SECRET). Changing it later means reconnecting Drive.
# DRIVE_TOKEN_KEY=

# Optional: AES-256-GCM encryption of every backup (browser download, Google Drive,
# pre-migration snapshots). Generate with: openssl rand -base64 32
# Keep a copy OUTSIDE the server: without it encrypted backups cannot be opened.
# BACKUP_ENCRYPTION_KEY=

# A real address with HTTPS (Caddy, deploy/caddy/Caddyfile). Point a domain at
# this server, open ports 80 and 443, and set the four lines below; Caddy gets
# and renews the certificate by itself. Leave them out for plain HTTP on
# http://localhost:<WEB_PORT>.
# SITE_ADDRESS=stocks.example.com
# This PC only (nobody else on the network can open it): BIND_ADDRESS=127.0.0.1
# CLIENT_ORIGIN=https://stocks.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
